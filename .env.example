# Copia a .env para desarrollo local (no versionar .env)
DATABASE_URL=jdbc:postgresql://localhost:5432/helpdesk
DATABASE_USERNAME=helpdesk
DATABASE_PASSWORD=helpdesk
JWT_SECRET=change-me-in-production-use-at-least-32-chars!!
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Cloud Run — un solo secret JSON en Secret Manager (helpdesk-runtime):
# HELPDESK_RUNTIME_JSON={"DATABASE_URL":"...","DATABASE_USERNAME":"...","DATABASE_PASSWORD":"...","JWT_SECRET":"..."}
